# ==========================================================
# Universal-RAG  —  Environment Configuration
# Copy this file to `.env` (already named .env) and fill in
# your real values. Never commit real keys to version control.
# ==========================================================

# ---- LLM Provider -------------------------------------------------
GOOGLE_API_KEY="AIzaSyChh99IqSqVQ83Vkjlr87S5O62UzSgCDf4"
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2

# ---- Embeddings -----------------------------------------------------
# Provider: "openai" or "huggingface"
# - openai:      text-embedding-3-large (best quality, needs API key)
# - huggingface: sentence-transformers/paraphrase-multilingual-mpnet-base-v2
#                (free, local, works well for English + Bangla)
EMBEDDING_PROVIDER=huggingface
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
HF_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# ---- Vector DB --------------------------------------------------------
CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION_NAME=universal_rag_business

# ---- Chunking -----------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ---- Retrieval ------------------------------------------------------------
TOP_K=5
SEARCH_TYPE=mmr

# ---- App ------------------------------------------------------------------
APP_NAME=Universal RAG - Business Assistant
APP_LANGUAGES=en,bn
DEFAULT_LANGUAGE=auto

# ---- Paths ------------------------------------------------------------------
DATA_DIR=data
UPLOADS_DIR=uploads
LOGS_DIR=logs
CACHE_DIR=cache
